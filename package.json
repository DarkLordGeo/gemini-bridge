{
  "name": "gemini-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Local, approval-gated macOS execution layer for the Gemini web app (via MCP SuperAssistant). No Gemini API.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "setup": "npm run build && node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@srbhptl39/mcp-superassistant-proxy": "0.1.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3"
  }
}
